
{
  "storage_account": {
    "name": "secureStorage",
    "allow_blob_public_access": false,
    "https_only": true
  },
  "network_security_group": {
    "name": "secureNSG",
    "rules": [
      {
        "name": "AllowSSH",
        "port": 22,
        "source": "10.0.0.0/24",
        "access": "Allow"
      },
      {
        "name": "AllowRDP",
        "port": 3389,
        "source": "10.0.0.0/24",
        "access": "Allow"
      }
    ]
  }
}
